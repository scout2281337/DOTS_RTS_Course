.monologue-panel {
    padding: 16px;
    background-color: rgba(4, 8, 10, 0.86);
    border-width: 2px;
    border-color: rgba(92, 238, 214, 0.74);
    border-radius: 18px;
    overflow: hidden;
}

.monologue-panel.radio {
    border-color: rgba(92, 238, 214, 0.78);
}

.monologue-panel.info {
    border-color: rgba(126, 196, 255, 0.82);
}

.monologue-panel.warning {
    border-color: rgba(255, 197, 88, 0.9);
}

.monologue-panel.danger {
    border-color: rgba(255, 72, 58, 0.94);
}

.monologue-panel.success {
    border-color: rgba(93, 255, 177, 0.94);
}

.monologue-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background-color: rgba(184, 255, 246, 0.28);
}

.monologue-header {
    height: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.monologue-speaker {
    color: rgb(225, 255, 249);
    font-size: 15px;
    -unity-font-style: bold;
}

.monologue-channel {
    color: rgba(255, 213, 124, 0.86);
    font-size: 10px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.monologue-message {
    min-height: 72px;
    white-space: normal;
    color: rgba(225, 255, 249, 0.92);
    font-size: 16px;
    -unity-font-style: bold;
}

.monologue-footer {
    height: 28px;
    margin-top: 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.monologue-hint {
    color: rgba(184, 255, 246, 0.62);
    font-size: 10px;
    -unity-font-style: bold;
}

.monologue-continue {
    height: 24px;
    min-width: 82px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(5, 12, 12);
    background-color: rgb(92, 238, 214);
    border-width: 0;
    border-radius: 12px;
    font-size: 10px;
    -unity-font-style: bold;
}

.monologue-progress-track {
    height: 6px;
    margin-top: 8px;
    background-color: rgba(22, 58, 58, 0.94);
    border-width: 1px;
    border-color: rgba(184, 255, 246, 0.24);
    border-radius: 5px;
    overflow: hidden;
}

.monologue-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(92, 238, 214);
    border-radius: 5px;
}

.monologue-panel.info .monologue-progress-fill,
.monologue-panel.info .monologue-continue {
    background-color: rgb(126, 196, 255);
}

.monologue-panel.warning .monologue-progress-fill,
.monologue-panel.warning .monologue-continue {
    background-color: rgb(255, 197, 88);
}

.monologue-panel.danger .monologue-progress-fill,
.monologue-panel.danger .monologue-continue {
    background-color: rgb(255, 72, 58);
}

.monologue-panel.success .monologue-progress-fill,
.monologue-panel.success .monologue-continue {
    background-color: rgb(93, 255, 177);
}

  Lines:
  - Speaker: "\u041E\u041F\u0415\u0420\u0410\u0422\u041E\u0420"
    Text: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440, \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u0441\u0432\u044F\u0437\u0438. \u0412 \u0434\u0430\u043D\u043D\u043E\u0439
      \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438 \u0432\u044B \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u0435\u0441\u044C
      \u0441 \u043E\u0441\u043D\u043E\u0432\u0430\u043C\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u043E\u0442\u0440\u044F\u0434\u043E\u043C."
    Hint: "\u0414\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
      \xAB\u0414\u0430\u043B\u044C\u0448\u0435\xBB."
    VoiceClip: {fileID: 0}
    Mood: 1
    StartDelay: 0
    Duration: 5
    WaitForClick: 1
  - Speaker: "\u041E\u041F\u0415\u0420\u0410\u0422\u041E\u0420"
    Text: "\u0412 \u0432\u0430\u0448\u0435 \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u0438\u0435
      \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u044B 4 \u0441\u043E\u043B\u0434\u0430\u0442\u0430.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438,
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438."
    Hint: 
    VoiceClip: {fileID: 0}
    Mood: 0
    StartDelay: 0
    Duration: 5
    WaitForClick: 1
  - Speaker: "\u041E\u041F\u0415\u0420\u0410\u0422\u041E\u0420"
    Text: "\u0427\u0442\u043E\u0431\u044B \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0433\u043E
      \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438.
      \u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u0430\u0436\u0430\u0442\u044C \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u043C\u044B\u0448\u0438 \u0438 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u0441\u0440\u0430\u0437\u0443 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442."
    Hint: 
    VoiceClip: {fileID: 0}
    Mood: 0
    StartDelay: 0
    Duration: 5
    WaitForClick: 1
  - Speaker: "\u041E\u041F\u0415\u0420\u0410\u0422\u041E\u0420"
    Text: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0438
      \u0432\u044B \u0437\u0430\u0436\u043C\u0451\u0442\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0443
      \xABShift\xBB, \u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u043A \u0443\u0436\u0435 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u043C.
      \u0415\u0441\u043B\u0438 \u0437\u0430\u0436\u043C\u0451\u0442\u0435 \xABCtrl\xBB,
      \u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u0431\u0440\u0430\u0442\u044C
      \u0435\u0433\u043E \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445."
    Hint: "\u0414\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F
      \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u0435 \u0432\u0441\u0435\u0445 \u0441\u043E\u043B\u0434\u0430\u0442."
    VoiceClip: {fileID: 0}
    Mood: 0
    StartDelay: 0
    Duration: 5
    WaitForClick: 1

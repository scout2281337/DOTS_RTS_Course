unity-text-element {
    margin: 0;
    padding: 5px;
    color: var(--white);
    -unity-font-definition: url("project://database/Assets/Visual/UIToolkit/Fonts/Tektur/Tektur-Medium SDF.asset");
}

.unity-label {
    color: var(--white);
    margin: 0;
    padding: 0px;
}

.H1 {
    font-size: 60px;
    letter-spacing: 4px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Visual/UIToolkit/Fonts/StalinistOne/StalinistOne-Regular SDF.asset");
}

.H2 {
    font-size: 48px;
    letter-spacing: 0px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Visual/UIToolkit/Fonts/StalinistOne/StalinistOne-Regular SDF.asset");
}


.bottomSection {
    top: 840px;
    align-self: center;
    width: 1400px;
    height: 240px;
    padding-bottom: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.unitProfile {
    width: 300px;
    height: 200px;
}

.moduleMesh {
    width: 300px;
    height: 80px;
    -unity-background-image-tint-color: var(--accent-main-50);
}

.attributesContainer {
    width: 300px;
    height: 120px;
    background-color: var(--dark-gray-50);
    border-width: 3px;
    border-color: var(--accent-main);
    padding: 7px;
}

.skillHealthBlock {
    height: 50px;
    flex-direction: row;
}

.skillButton {
    width: 75px;
    height: 50px;
}

.healthBar {
    flex-grow: 1;
}

.statsBoard {
    height: 45px;
    margin-top: 5px;
    justify-content: space-between;
}

.statBoard {
    height: 23px;
    flex-direction: row;
    justify-content: space-between;
    -unity-text-align: middle-center;
}

.statElement {
    width: 83px;
}
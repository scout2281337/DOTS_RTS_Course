.bottomSection {
    top: 810px;
    align-self: center;
    width: 1920px;
    height: 270px;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
}

.unitProfile {
    width: 330px;
    height: 150px;
}

.moduleMesh {
    height: 70px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--accent-main-50);
    flex-direction: row;
    justify-content: space-evenly;
}

.moduleSlot{
    width: 40px;
    height: 40px;
    rotate: 45deg;
    align-items: center;
    justify-content: center;
}

.moduleIcon{
    width: 35px;
    height: 35px;
}

.attributesContainer {
    height: 80px;
    flex-shrink: 0;
    background-color: var(--dark-gray-50);
    border-width: 3px;
    border-color: var(--accent-main);
    padding: 7px;
    flex-direction: row;
    justify-content: space-between;
}

.skillBlock {
    width: 75px;
    height: 60px;
    flex-direction: row;
    justify-content: space-between;
}

.skillButton {
    width: 60px;
    height: 60px;
}
    .skillButton.Activated {
        -unity-background-image-tint-color: var(--accent-main-50);
    }
    .skillButton.Cooldown {
        -unity-background-image-tint-color: var(--dark-gray-50);
    }

.cooldownBarContainer {
    width: 10px;
    height: 60px;
    flex-direction: row;
    justify-content: center;
}

.skillCooldownBar {
    width: 60px;
    height: 10px;
    top: 25px;
    rotate: -90deg;
}

    .skillCooldownBar .unity-progress-bar__progress {
        background-color: var(--white);
    }

.healthBar {
    width: 225px;
    height: 60px;
}

.delayedHealthBar {
    width: 225px;
    height: 60px;
    position: absolute;
}
    .delayedHealthBar .unity-progress-bar__progress {
        background-color: var(--second-main);
    }

.trueHealthBar {
    width: 225px;
    height: 60px;
    position: absolute;
}
    .trueHealthBar .unity-progress-bar__background {
        background-color: #00000000;
    }

.healthAmount {
    width: 225px;
    height: 60px;
    -unity-text-align: middle-center;
    letter-spacing: 40px;
}
.soldierPanel {
    align-self: center;
    top: 690px;
    width: 1880px;
    height: 350px;
    margin: 20px;
    border-width: 4px;
    padding: 10px;
    flex-direction: row;
    justify-content: space-between;
}

.attributeBox {
    width: 620px;
    margin: 10px;
    padding: 10px;
    
}

.buttonBox {
    flex-direction: row;
}

.attributeButton {
    height: 50px;
    flex-grow: 1;
    margin-bottom: 5px;
}

.attributeDescription {
    height: 80px;
    padding: 10px;
    white-space: normal;
    margin-bottom: 5px;
    font-size: 18px;
    -unity-text-align: middle-left;
}

.miscBox {
    flex-grow: 1;
    padding: 10px;
    justify-content: space-evenly;
    font-size: 18px;
}
